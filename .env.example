# Copia este archivo a .env y rellena tus datos.
# No subas el archivo .env al repositorio.

# Obligatorio: app en https://kick.com/settings/developer
KICK_CLIENT_ID=tu_client_id
KICK_CLIENT_SECRET=tu_client_secret

# Slug del canal (lo que va después de kick.com/)
# Ejemplo: https://kick.com/abera-cloud  →  abera-cloud
KICK_CHANNEL=tu-canal

# Opcional. Debe coincidir EXACTAMENTE con el Redirect URI de tu app en Kick.
# KICK_REDIRECT_URI=http://localhost:8079/callback

# Opcional. Segundos entre cada consulta de viewers.
# POLL_INTERVAL=5

# Opcional. Segundos mínimos entre mensajes de bienvenida al chat.
# CHAT_COOLDOWN=30

# Opcional. Mensaje que se envía al chat cuando suben los viewers.
# CHAT_MESSAGE=👋 ¡Gracias por unirte al stream! Si quieres, saluda en el chat 😄
